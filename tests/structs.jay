fn add(int a, int b): int {
    return a + b
}

fn display(int value): void {
    print(value)
}

struct Point {
    int x
    int y
    str label
}

fn make_point(int x, int y, str label): Point {
    return Point(x, y, label)
}

Point point = make_point(10, 20, "origin")
print(add(point.x, point.y))
point.x = 25
print(point.x)
print(point.y)
print(point.label)
display(7)
