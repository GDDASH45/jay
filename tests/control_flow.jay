# Exercise conditionals, loops, break, and continue
int count = 0
int total = 0
while (count < 10) {
    count = count + 1
    if (count == 3) {
        continue
    }
    if (count == 6) {
        break
    }
    total = total + count
}
print(total)
if (total == 12) {
    print("control flow: ok")
} else {
    print("control flow: failed")
}