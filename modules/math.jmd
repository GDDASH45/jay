fn square(int value) {
    return value * value
}

fn cube(int value) {
    return value * value * value
}

fn absolute(int value) {
    if (value < 0) {
        return 0 - value
    }
    return value
}

fn max(int a, int b) {
    if (a > b) {
        return a
    }
    return b
}

fn min(int a, int b) {
    if (a < b) {
        return a
    }
    return b
}
