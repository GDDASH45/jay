struct Point {
    int x
    int y
}

fn make_point(int x, int y): Point {
    return Point(x, y)
}

fn distance_squared(Point a, Point b): int {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return dx * dx + dy * dy
}

Point first = make_point(2, 3)
Point second = make_point(5, 7)

print(distance_squared(first, second))
